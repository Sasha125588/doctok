{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "env": [
                "OPENAPI_SPEC_URL",
                "NUXT_API_BASE_URL",
                "NUXT_PUBLIC_API_BASE_URL"
            ],
            "outputs": [
                "dist/**",
                ".output/**",
                ".vercel/output/**"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types"
            ]
        },
        "dev": {
            "persistent": true,
            "cache": false
        }
    }
}
